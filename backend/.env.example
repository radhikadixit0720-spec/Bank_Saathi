# Copy this file to backend/.env for local development.
# Never commit the real .env file.

# MongoDB / MongoDB Atlas connection string.
# If left empty, Bank Saathi automatically falls back to an in-memory data
# store so the app still runs end-to-end for local development/demo -
# but nothing will persist between restarts. Set this to enable real
# persistence.
MONGODB_URI=

# Name of the database to use inside your MongoDB cluster.
MONGODB_DB_NAME=bank_saathi

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enable AI-generated Simple Language explanations.
# Leave empty to use the built-in rule-based simplifier (no key needed).
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=10
